{
  "version": 2,
  "builds": [
    {
      "src": "vercel.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "vercel.js"
    },
    {
      "src": "/(.*)",
      "dest": "vercel.js"
    }
  ],
  "buildCommand": "npm run build",
  "installCommand": "npm install"
}